<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://jmix.io/schema/ui/window"
        caption="msg://com.company.statemachine.entity/State.browse"
        focusComponent="statesTable">
    <data readOnly="true">
        <collection id="statesDc"
                    class="com.company.statemachine.entity.State">
            <fetchPlan extends="_base">
                <property name="template" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="statesDl">
                <query>
                    <![CDATA[select e from State e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="statesTable" spacing="true">
        <filter id="filter"
                dataLoader="statesDl">
            <properties include=".*"/>
        </filter>
        <groupTable id="statesTable"
                    width="100%"
                    dataContainer="statesDc">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="remove" type="remove"/>
            </actions>
            <columns>
                <column id="name"/>
                <column id="stateKey"/>
                <column id="template"/>
                <column id="isFinal"/>
            </columns>
            <buttonsPanel id="buttonsPanel"
                          alwaysVisible="true">
                <button id="createBtn" action="statesTable.create"/>
                <button id="editBtn" action="statesTable.edit"/>
                <button id="removeBtn" action="statesTable.remove"/>
            </buttonsPanel>
        </groupTable>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
