<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://jmix.io/schema/ui/window"
        caption="msg://com.company.statemachine.entity/StateMachineTemplate.browse"
        focusComponent="stateMachineTemplatesTable">
    <data readOnly="true">
        <collection id="stateMachineTemplatesDc"
                    class="com.company.statemachine.entity.StateMachineTemplate">
            <fetchPlan extends="_base"/>
            <loader id="stateMachineTemplatesDl">
                <query>
                    <![CDATA[select e from StateMachineTemplate e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="stateMachineTemplatesTable" spacing="true">
        <filter id="filter"
                dataLoader="stateMachineTemplatesDl">
            <properties include=".*"/>
        </filter>
        <groupTable id="stateMachineTemplatesTable"
                    width="100%"
                    dataContainer="stateMachineTemplatesDc">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="visualEdit" caption="Visual Editor" icon="EDIT"/>
                <action id="remove" type="remove"/>
            </actions>
            <columns>
                <column id="name"/>
                <column id="description"/>
                <column id="active"/>
            </columns>
            <buttonsPanel id="buttonsPanel"
                          alwaysVisible="true">
                <button id="createBtn" action="stateMachineTemplatesTable.create"/>
                <button id="editBtn" action="stateMachineTemplatesTable.edit"/>
                <button id="visualEditBtn" action="stateMachineTemplatesTable.visualEdit"/>
                <button id="removeBtn" action="stateMachineTemplatesTable.remove"/>
            </buttonsPanel>
        </groupTable>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
